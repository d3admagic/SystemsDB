-- What are fuctions in SQL?
-- Fuctions = Built-in operations that perform a specific task insidr a query

-- Common bulit in fuctions
-- ROUND(): Round a number to n decimals. EX. SELECT ROUND(3.14159,2)  Result: 3.14
-- CEIL()/FLOOR(): Round up or down.      EX. SELECT CEIL(2.1); -> 3

-- Text Fuctions
-- UPPER(Text), converts text to uppercase EX. SELECT UPPER(category)
-- LOWER(text), converts text to lowercase    EX. SELECT LOWER(product_name)
-- LENGTH(), returns character count 		   EX. SELECT LENGTH(product_name)



-- DATE FUCTIONS 
-- NOW(), current timestamp 				EX: SELECT NOW();
-- CURRENT_DATE, Todays date				EX: SELECT CURRENT_DATE;
-- AGE(), returns the difference between 2 dates. EX: SELECT AGE('2025-10-20','2000-05-15');   OUTPUT : 25 yrs 5 mons 5 days



